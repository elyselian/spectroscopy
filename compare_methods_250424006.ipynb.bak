    "# Peak-finder sensitivity on Method A (spatial peaks)\n",
    "smooth_values = [5, 9, 15]\n",
    "med_A_counts = []\n",
    "for sw in smooth_values:\n",
    "    cfg = dict(CONFIG[\"spatial_peak\"])\n",
    "    cfg[\"smooth_window\"] = sw\n",
    "    tmp = extract_20_spatial_peaks_at_column(img_spe, col0, cfg)\n",
    "    med_A_counts.append(float(np.nanmedian(tmp[\"counts\"])))\n",
    "\n",
    "plt.figure(figsize=(6.0, 3.0))\n",
    "plt.plot(smooth_values, med_A_counts, \"o-\")\n",
    "plt.title(\"Sensitivity: Method A median peak counts vs smoothing window\")\n",
    "plt.xlabel(\"smooth_window (pixels)\")\n",
    "plt.ylabel(\"median peak counts\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()"
