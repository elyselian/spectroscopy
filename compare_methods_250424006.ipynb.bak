   "source": [
    "# Plot calibration spectra (counts vs wavelength) for selected fibers\n",
    "sel = [0, 5, 9, 10, 14, 19]\n",
    "plt.figure(figsize=(7, 3.5))\n",
    "for idx in sel:\n",
    "    spec = np.asarray(fibers[idx][\"row_profile_full\"], dtype=float)\n",
    "    spec_bs = spec - np.nanmin(spec)\n",
    "    plt.plot(wl_nm, spec_bs, label=f\"fiber {idx+1}\")\n",
    "plt.title(\"Method B Step 1: calibration mean spectra (baseline-subtracted)\")\n",
    "plt.xlabel(\"Wavelength (nm)\")\n",
    "plt.ylabel(\"Counts (arb, baseline-subtracted)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend(ncol=3, fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Show multiplier at lambda0 used later\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(mult_at_lambda0, \"o-\")\n",
    "plt.title(\"Method B Step 1: multiplier(λ0) used for counts→irradiance\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"(µW/cm²)/count at λ0\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
