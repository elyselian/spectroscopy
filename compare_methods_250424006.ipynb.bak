   ],
   "source": [
    "# Step 1 plots: irradiance-per-count curves + multiplier at lambda0 per fiber\n",
    "lambda0_nm = float(CONFIG[\"lambda0_nm\"])\n",
    "wl_nm = np.asarray(fibers[0][\"wavelength_nm\"], dtype=float)\n",
    "col0 = int(np.nanargmin(np.abs(wl_nm - lambda0_nm)))\n",
    "print(f\"Calibration wavelength grid: col0={col0}, wl[col0]={wl_nm[col0]:.4f} nm\")\n",
    "\n",
    "mult_at_lambda0 = np.array([float(np.asarray(f[\"irradiance_multiplier\"])[col0]) for f in fibers])  # (uW/cm^2)/count\n",
    "plt.figure(figsize=(7, 3.5))\n",
    "plt.plot(mult_at_lambda0, \"o-\")\n",
    "plt.title(\"Calibration: irradiance-per-count at 229.7 nm (per fiber)\")\n",
    "plt.xlabel(\"Fiber index (top→bottom)\")\n",
    "plt.ylabel(\"(µW/cm²)/count\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Overlay a few full curves to check shape\n",
    "plt.figure(figsize=(7, 3.5))\n",
    "for idx in [0, 5, 9, 10, 14, 19]:\n",
    "    mult = np.asarray(fibers[idx][\"irradiance_multiplier\"], dtype=float)\n",
    "    plt.plot(wl_nm, mult, label=f\"fiber {idx+1}\")\n",
    "plt.title(\"Calibration: irradiance-per-count(λ) for selected fibers\")\n",
    "plt.xlabel(\"Wavelength (nm)\")\n",
    "plt.ylabel(\"(µW/cm²)/count\")\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.legend(ncol=3, fontsize=8)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Campaign absolute calibration (from SXB_Analysis.py) for context\n",
    "sxb_cal = np.load(CONFIG[\"SXB_CAL_NPY\"], allow_pickle=True)\n",
    "gate_cal_s = float(CONFIG[\"gate_cal_s\"])\n",
    "\n",
    "# NOTE: in this repo, sxb_cal.npy is shaped (4, 20) so sxb_cal[3] is per-chord counts (not a scalar).\n",
    "counts_cal_raw = np.asarray(sxb_cal[3], dtype=float).squeeze()\n",
    "if counts_cal_raw.ndim == 0:\n",
    "    counts_cal_per_s = float(counts_cal_raw) / gate_cal_s\n",
    "else:\n",
    "    counts_cal_per_s = counts_cal_raw / gate_cal_s\n",
    "print(\"sxb_cal.npy:\")\n",
    "print(\"  shape           =\", np.asarray(sxb_cal).shape)\n",
    "print(\"  counts_cal shape=\", np.asarray(counts_cal_per_s).shape)\n",
    "\n",
    "Irr_abs_uW_cm2_per_nm = 6.3525963157828755  # from SXB_Analysis.py at 229.7 nm\n",
    "Irr_abs_W_m2 = Irr_abs_uW_cm2_per_nm * 1e-6 * 1e4 * lambda0_nm  # matches SXB_Analysis scaling\n",
    "E_ph = float(CONFIG[\"h\"]) * float(CONFIG[\"c\"]) / (lambda0_nm * 1e-9)\n",
    "print(\"Campaign scalar calibration constants:\")\n",
    "print(\"  Irr_abs_W_m2     =\", Irr_abs_W_m2)\n",
    "print(\"  E_ph (J)         =\", E_ph)\n"
   ]
  },
