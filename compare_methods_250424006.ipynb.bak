   "source": [
    "## Method A (campaign-style) — Step 1: peak-find at $\\lambda_0$ → counts per fiber\n",
    "This matches your updated campaign idea: at a single wavelength column (near 229.7 nm), find 20 spatial peaks corresponding to the 20 fibers/chords."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "31f8c9eb",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Method A: extracted 20 peak counts at lambda0\n",
      "  y_idx[0:5]= [ 28  78 121 169 218]\n",
      "  counts[0:5]= [ 2683.88888889  6784.88888889 14633.11111111 13077.22222222\n",
      "  8500.22222222]\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x420 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "from shot_processing import extract_20_peaks_middle_column\n",
    "\n",
    "# Use SPE image if available; otherwise use HDF5 image\n",
    "img_A = img_spe if img_spe is not None else img_h5\n",
    "\n",
    "# Method A peak-find (existing repo function): always uses the middle column\n",
    "colA = int(img_A.shape[1] // 2)\n",
    "print(f\"Method A: using middle column colA={colA}\")\n",
    "print(f\"  wl[col0] (lambda0 target) = {wl_nm[col0]:.4f} nm\")\n",
    "print(f\"  wl[colA] (middle column)  = {wl_nm[colA]:.4f} nm\")\n",
    "print(f\"  colA-col0 = {colA - col0} pixels\")\n",
    "\n",
    "cfg = CONFIG[\"spatial_peak\"]\n",
    "A_counts_peak, A_y = extract_20_peaks_middle_column(\n",
    "    img_A,\n",
    "    smooth_window=int(cfg.get(\"smooth_window\", 12)),\n",
    "    min_distance=int(cfg.get(\"min_distance\", 35)),\n",
    "    start_mult=float(cfg.get(\"start_mult\", 0.6)),\n",
    "    max_iter=int(cfg.get(\"max_iter\", 40)),\n",
    "    allow_trim=True,\n",
    ")\n",
    "if A_counts_peak is None or A_y is None:\n",
    "    raise RuntimeError(\"Method A: could not extract 20 peaks from the middle column\")\n",
    "\n",
    "A_counts_peak = np.asarray(A_counts_peak, dtype=float)\n",
    "A_y = np.asarray(A_y, dtype=int)\n",
    "print(\"Method A: extracted 20 peak counts\")\n",
    "print(\"  y_idx[0:5]=\", A_y[:5])\n",
    "print(\"  counts[0:5]=\", A_counts_peak[:5])\n",
    "\n",
    "# Plot spatial profile and peaks\n",
    "plt.figure(figsize=(7, 3.5))\n",
    "y = np.arange(img_A.shape[0])\n",
    "col_profile = np.asarray(img_A[:, colA], dtype=float)\n",
    "plt.plot(y, col_profile, label=\"col profile\")\n",
    "plt.plot(A_y, col_profile[A_y], \"x\", label=\"peaks\")\n",
    "plt.title(f\"Method A Step 1: spatial peaks at col={colA} (~{wl_nm[colA]:.3f} nm)\")\n",
    "plt.xlabel(\"Spatial pixel (y)\")\n",
    "plt.ylabel(\"Counts\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Per-fiber peak counts\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(A_counts_peak, \"o-\")\n",
    "plt.title(\"Method A Step 1: peak counts per fiber (ordered top→bottom)\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"Peak counts\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
