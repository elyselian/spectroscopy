   "source": [
    "# Left/right asymmetry: compare symmetric chord pairs\n",
    "pairs = [(i, 19 - i) for i in range(10)]\n",
    "\n",
    "def asymmetry(arr):\n",
    "    arr = np.asarray(arr, float)\n",
    "    d = []\n",
    "    for i, j in pairs:\n",
    "        ai, aj = arr[i], arr[j]\n",
    "        d.append((ai - aj) / np.maximum(0.5 * (np.abs(ai) + np.abs(aj)), 1e-30))\n",
    "    return np.array(d, float)\n",
    "\n",
    "A_asym = asymmetry(A_irr_uW_cm2)\n",
    "B_asym = asymmetry(B_irr_lambda0_uW_cm2)\n",
    "\n",
    "plt.figure(figsize=(7, 3.0))\n",
    "plt.plot(A_asym, \"o-\", label=\"A asym (irr@λ0)\")\n",
    "plt.plot(B_asym, \"s-\", label=\"B asym (irr@λ0)\")\n",
    "plt.axhline(0, color=\"k\", lw=1, alpha=0.5)\n",
    "plt.title(\"Diagnostics: left/right asymmetry per symmetric chord pair\")\n",
    "plt.xlabel(\"Pair index (0=outermost)\")\n",
    "plt.ylabel(\"(L-R)/mean(|L|,|R|)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Sensitivity: re-run Method B extraction for a few sauvola_k values (fast coarse scan)\n",
    "k_values = [0.15, 0.2, 0.25, 0.3]\n",
    "ratios = []\n",
    "for k in k_values:\n",
    "    tmp = extract_real_image_fiber_intensities(\n",
    "        img=img_h5,\n",
    "        fibers=fibers,\n",
    "        min_area=int(CONFIG[\"roi\"][\"min_area\"]),\n",
    "        sauvola_window=int(CONFIG[\"roi\"][\"sauvola_window\"]),\n",
    "        sauvola_k=float(k),\n",
    "        profile_half_height=int(CONFIG[\"roi\"][\"profile_half_height\"]),\n",
    "        spatial_collapse=str(CONFIG[\"roi\"][\"spatial_collapse\"]),\n",
    "        use_trapz=True,\n",
    "    )\n",
    "    tmp_irr0 = np.array([float(np.asarray(spec)[col0]) for spec in tmp[\"spectra_uW_cm2\"]]) * gate_corr\n",
    "    ratios.append(float(np.nanmedian(tmp_irr0 / np.maximum(A_irr_uW_cm2, 1e-30))))\n",
    "\n",
    "plt.figure(figsize=(6.0, 3.0))\n",
    "plt.plot(k_values, ratios, \"o-\")\n",
    "plt.axhline(1.0, color=\"k\", lw=1, alpha=0.5)\n",
    "plt.title(\"Diagnostics: median(B/A) vs Sauvola k\")\n",
    "plt.xlabel(\"sauvola_k\")\n",
    "plt.ylabel(\"median(B/A)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
