    "def summarize(name: str, arr: np.ndarray):\n",
    "    arr = np.asarray(arr, dtype=float)\n",
    "    m = np.isfinite(arr)\n",
    "    if not np.any(m):\n",
    "        return {\"name\": name, \"median\": np.nan, \"max\": np.nan, \"center10\": np.nan}\n",
    "    center_idx = [9, 10]\n",
    "    center_val = float(np.nanmean(arr[center_idx]))\n",
    "    return {\n",
    "        \"name\": name,\n",
    "        \"median\": float(np.nanmedian(arr[m])),\n",
    "        \"max\": float(np.nanmax(arr[m])),\n",
    "        \"center(9-10)\": center_val,\n",
    "    }\n",
    "\n",
    "summaries = [\n",
    "    summarize(\"A0 photon_flux\", A0_photon_flux),\n",
    "    summarize(\"A1 photon_flux\", A1_photon_flux),\n",
    "    summarize(\"B  photon_flux\", B_photon_flux),\n",
    "    summarize(\"A0 erosion_flux\", A0_erosion_flux),\n",
    "    summarize(\"A1 erosion_flux\", A1_erosion_flux),\n",
    "    summarize(\"B  erosion_flux\", B_erosion_flux),\n",
    " ]\n",
    "for s in summaries:\n",
    "    print(s)\n",
    "\n",
    "def safe_ratio(num, den):\n",
    "    num = np.asarray(num, float)\n",
    "    den = np.asarray(den, float)\n",
    "    return num / np.maximum(den, 1e-30)\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(x_mm, safe_ratio(B_erosion_flux, A1_erosion_flux), \"o-\", label=\"B/A1\")\n",
    "plt.plot(x_mm, safe_ratio(B_erosion_flux, A0_erosion_flux), \"s-\", label=\"B/A0\")\n",
    "plt.axhline(1.0, color=\"k\", lw=1, alpha=0.5)\n",
    "plt.xlabel(\"Chord position x (mm)\")\n",
    "plt.ylabel(\"ratio\")\n",
    "plt.title(\"Final comparison: erosion flux ratios\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
