   "source": [
    "## Method A — Step 2: peak counts → irradiance at $\\lambda_0$\n",
    "Two calibrations are compared:\n",
    "- **A1 (per-fiber multiplier)**: `irr(λ0) = counts(λ0) * multiplier_fiber(λ0) * (gate_cal/gate_exp)`\n",
    "- **A0 (campaign scalar)**: uses `counts_cal` + `Irr_abs` at 229.7 nm (as in `SXB_Analysis.py`)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "ada212f2",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "gate_exp_s=5.000e-08 s, gate_corr=4.200e+08\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "gate_exp_s = float(gate_width_ns_h5) * 1e-9 if np.isfinite(gate_width_ns_h5) else float(gate_width_ns_spe) * 1e-9\n",
    "if not np.isfinite(gate_exp_s) or gate_exp_s <= 0:\n",
    "    raise ValueError(\"Could not determine gate_exp_s from HDF5 or SPE metadata\")\n",
    "gate_corr = float(CONFIG[\"gate_cal_s\"]) / gate_exp_s\n",
    "print(f\"gate_exp_s={gate_exp_s:.3e} s, gate_corr={gate_corr:.3e}\")\n",
    "\n",
    "# A1: per-fiber multiplier at Method A's extraction column (middle column)\n",
    "colA = int(img_A.shape[1] // 2)\n",
    "mult_at_colA = np.array([float(np.asarray(f[\"irradiance_multiplier\"])[colA]) for f in fibers])\n",
    "A_irr_uW_cm2 = A_counts_peak * mult_at_colA * gate_corr\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(A_irr_uW_cm2, \"o-\")\n",
    "plt.title(f\"Method A Step 2 (A1): irradiance at col={colA} (~{wl_nm[colA]:.3f} nm)\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"I [µW/cm²]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# A0: campaign scalar absolute calibration, converted to photon flux directly (SXB_Analysis style)\n",
    "counts_exp_per_s = A_counts_peak / gate_exp_s\n",
    "A0_photon_flux = (counts_exp_per_s / counts_cal_per_s) * Irr_abs_W_m2 / E_ph  # photons / m^2 / s\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(A0_photon_flux, \"o-\")\n",
    "plt.title(\"Method A Step 2 (A0): photon flux via campaign scalar calibration\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"Photon flux [ph/m²/s]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "05df3f0a",
   "metadata": {},
   "source": [
