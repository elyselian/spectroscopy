   "source": [
    "B_result = extract_real_image_fiber_intensities(\n",
    "    img=img_h5,\n",
    "    fibers=fibers,\n",
    "    min_area=int(CONFIG[\"roi\"][\"min_area\"]),\n",
    "    sauvola_window=int(CONFIG[\"roi\"][\"sauvola_window\"]),\n",
    "    sauvola_k=float(CONFIG[\"roi\"][\"sauvola_k\"]),\n",
    "    profile_half_height=int(CONFIG[\"roi\"][\"profile_half_height\"]),\n",
    "    spatial_collapse=str(CONFIG[\"roi\"][\"spatial_collapse\"]),\n",
    "    use_trapz=True,\n",
    " )\n",
    "\n",
    "B_int_band_uW_cm2_nm = np.asarray(B_result[\"fiber_intensities_uW_cm2\"], dtype=float)  # WARNING: unit is (uW/cm^2)*nm if trapz over wavelength\n",
    "B_spectra_uW = B_result[\"spectra_uW_cm2\"]  # list of full-width spectra (uW/cm^2 per pixel)\n",
    "B_spectra_counts = B_result[\"spectra_counts\"]\n",
    "print(\"B_result: spectra count list len=\", len(B_spectra_uW), \"intensities shape=\", B_int_band_uW_cm2_nm.shape)\n",
    "\n",
    "# Step 2 plots: masks + spectra for a few fibers\n",
    "sel = [0, 9, 10, 19]\n",
    "for idx in sel:\n",
    "    bbox = B_result[\"local_bboxes\"][idx]\n",
    "    mask = B_result[\"illuminated_masks\"][idx]\n",
    "    x0, y0, w, h = bbox\n",
    "    local = img_h5[int(y0):int(y0+h), int(x0):int(x0+w)]\n",
    "    plt.figure(figsize=(6.2, 2.6))\n",
    "    plt.imshow(local, cmap=\"gray\", aspect=\"auto\", vmin=np.percentile(local, 5), vmax=np.percentile(local, 99.7))\n",
    "    plt.imshow(np.ma.masked_where(~mask, mask), cmap=\"Reds\", alpha=0.35, aspect=\"auto\")\n",
    "    plt.title(f\"Method B Step 2: fiber {idx+1} local ROI + illuminated mask\")\n",
    "    plt.axis(\"off\")\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "    spec_counts = np.asarray(B_spectra_counts[idx], dtype=float)\n",
    "    spec_uW = np.asarray(B_spectra_uW[idx], dtype=float)\n",
    "    plot_spectrum_compare(wl_nm, baseline_subtract(spec_counts, mode=\"min\"), baseline_subtract(spec_uW, mode=\"min\"),\n",
    "                          title=f\"Fiber {idx+1}: counts(λ) vs irradiance(λ) (baseline-subtracted)\",\n",
    "                          labels=(\"counts\", \"uW/cm²\"),\n",
    "                          l1=CONFIG[\"band\"][\"lambda1_nm\"], l2=CONFIG[\"band\"][\"lambda2_nm\"])\n",
    "\n",
    "# Irradiance at lambda0 from Method B spectra (uW/cm^2); apply exposure correction\n",
    "B_irr_lambda0_uW_cm2 = np.array([float(np.asarray(spec)[col0]) for spec in B_spectra_uW]) * gate_corr\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(B_irr_lambda0_uW_cm2, \"o-\", label=\"B irradiance @ λ0\")\n",
    "plt.title(\"Method B Step 2: irradiance at λ0 (from spectrum) [gate-corrected]\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"I(λ0) [µW/cm²]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
