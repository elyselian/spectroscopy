    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Extracted fibers: 20\n"
     ]
    }
   ],
   "source": [
    "from pathlib import Path\n",
    "\n",
    "cal_folder = Path(CONFIG[\"CAL_FOLDER\"])\n",
    "lamp_csv = Path(CONFIG[\"LAMP_CSV\"])\n",
    "assert cal_folder.exists(), f\"Calibration folder not found: {cal_folder}\"\n",
    "assert lamp_csv.exists(), f\"Lamp CSV not found: {lamp_csv}\"\n",
    "\n",
    "spe_files = sorted(cal_folder.glob(\"*.spe\"))\n",
    "print(f\"Found {len(spe_files)} calibration SPEs\")\n",
    "\n",
    "N_SKIP = 6\n",
    "spe_files_used = spe_files[N_SKIP:] if len(spe_files) > N_SKIP else spe_files\n",
    "print(f\"Using {len(spe_files_used)} calibration SPEs\")\n",
    "\n",
    "stacked = None\n",
    "for f in spe_files_used:\n",
    "    img = load_spe_image(str(f))\n",
    "    stacked = img.astype(np.float64) if stacked is None else stacked + img.astype(np.float64)\n",
    "\n",
    "print(\"Stacked calibration image:\", stacked.shape, stacked.dtype)\n",
    "plt.figure(figsize=(7, 4))\n",
    "plt.imshow(stacked, cmap=\"gray\", aspect=\"auto\", vmin=np.percentile(stacked, 1), vmax=np.percentile(stacked, 99.7))\n",
    "plt.title(f\"Calibration overlay (summed): {len(spe_files_used)} SPEs\")\n",
    "plt.colorbar(label=\"summed counts\")\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "fibers = extract_fiber_and_calibrate(\n",
    "    stacked,\n",
    "    lamp_csv_path=str(lamp_csv),\n",
    "    sauvola_k=0.01,\n",
    "    smooth_window=5,\n",
    "    n_fibers=20,\n",
    "    n_pixels=1024,\n",
    " )\n",
    "\n",
    "if not fibers:\n",
    "    raise RuntimeError(\"No fibers detected from calibration overlay.\")\n",
    "\n",
    "show_fiber_boxes(stacked, fibers, title=\"Detected fiber ROIs (from calibration overlay)\")\n",
    "print(\"Extracted fibers:\", len(fibers))"
   ]
  },
