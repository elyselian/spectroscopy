  {
   "cell_type": "markdown",
   "id": "4beb0c4e",
   "metadata": {},
   "source": [
    "## Method B — Step 2b: integrate irradiance over a bandpass\n",
    "This isolates a common source of mismatch: using **single-wavelength** vs **band-integrated** signal. We integrate only over a window around the line (configurable)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 28,
   "id": "78abc9b2",
   "metadata": {},
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 504x504 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x360 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "l1 = float(CONFIG[\"band\"][\"lambda1_nm\"])\n",
    "l2 = float(CONFIG[\"band\"][\"lambda2_nm\"])\n",
    "m_band = (wl_nm >= l1) & (wl_nm <= l2)\n",
    "if not np.any(m_band):\n",
    "    raise ValueError(\"Band window does not overlap wavelength grid\")\n",
    "\n",
    "B_int_bandwin_uW_cm2_nm = np.array([float(np.trapezoid(np.asarray(spec)[m_band], wl_nm[m_band])) for spec in B_spectra_uW]) * gate_corr\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(B_int_bandwin_uW_cm2_nm, \"o-\")\n",
    "plt.title(f\"Method B Step 2b: ∫ I(λ) dλ over [{l1},{l2}] nm (gate-corrected)\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"Band-integrated irradiance [µW/cm²·nm]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Internal check: single-column vs band integral\n",
    "x = np.maximum(B_irr_lambda0_uW_cm2, 1e-30)\n",
    "y = np.maximum(B_int_bandwin_uW_cm2_nm, 1e-30)\n",
    "plt.figure(figsize=(4.2, 4.2))\n",
    "plt.scatter(x, y, s=25)\n",
    "plt.title(\"Method B internal check: I(λ0) vs band-integral\")\n",
    "plt.xlabel(\"I(λ0) [µW/cm²]\")\n",
    "plt.ylabel(\"∫I dλ [µW/cm²·nm]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(7, 3.0))\n",
    "plt.plot(y / x, \"o-\")\n",
    "plt.title(\"Method B internal check: (band-integral) / I(λ0)\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"nm (effective width)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f53dd4e7",
   "metadata": {},
   "source": [
    "## Step 3: edge-chord subtraction (no Abel inversion)\n",
    "We apply the same background subtraction logic used in `SXB_Analysis.py`: average the edge chords (first 4 + last 4) and subtract **half** that mean from every chord."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 29,
   "id": "ab064b71",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Edge bg means:\n",
      "  A bg mean = 465998956793.21484\n",
      "  B bg mean = 334566153230.6046\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "edge = np.array(CONFIG[\"edge_chords\"], dtype=int)\n",
    "\n",
    "def edge_subtract_half(x: np.ndarray, edge_idx: np.ndarray):\n",
    "    x = np.asarray(x, dtype=float)\n",
    "    bg_mean = float(np.nanmean(x[edge_idx]))\n",
    "    return x - 0.5 * bg_mean, bg_mean\n",
    "\n",
    "A_sub, A_bg = edge_subtract_half(A_irr_uW_cm2, edge)\n",
    "B_sub, B_bg = edge_subtract_half(B_irr_lambda0_uW_cm2, edge)\n",
    "print(\"Edge bg means:\")\n",
    "print(\"  A bg mean =\", A_bg)\n",
    "print(\"  B bg mean =\", B_bg)\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(A_irr_uW_cm2, \"o-\", alpha=0.6, label=\"A raw\")\n",
    "plt.plot(A_sub, \"o-\", label=\"A edge-sub\")\n",
    "plt.title(\"Method A: irradiance@λ0 before/after edge subtraction\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"I(λ0) [µW/cm²]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(B_irr_lambda0_uW_cm2, \"s-\", alpha=0.6, label=\"B raw\")\n",
    "plt.plot(B_sub, \"s-\", label=\"B edge-sub\")\n",
    "plt.title(\"Method B: irradiance@λ0 before/after edge subtraction\")\n",
    "plt.xlabel(\"Fiber index\")\n",
    "plt.ylabel(\"I(λ0) [µW/cm²]\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "27035a72",
   "metadata": {},
   "source": [
    "## Method B — Step 3: geometry inversion (least squares)\n",
    "This follows your clean approach: pick one side (default: right), build a path-length matrix, solve a least-squares system for shell emissivities, and flag negative/zero shells."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 30,
   "id": "65da37ad",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Geometry helper source: shot_processing\n",
      "Using chords for inversion:\n",
      "  b_keep(mm) = [11.8        10.48888889  9.17777778  7.86666667  6.55555556  5.24444444\n",
      "  3.93333333  2.62222222  1.31111111  0.        ]\n",
      "  I_keep     = [ 1.54894529e+11  1.22787256e+11 -4.25604173e+09 -7.89081466e+10\n",
      " -1.24193272e+11 -1.40262759e+11 -1.34438224e+11 -1.53799920e+11\n",
      " -1.56121277e+11 -1.31404438e+11]\n",
      "L shape: (5, 5) I_used shape: (5,)\n",
      "Shell emissivities (LS): [-5.32968976e+12  5.87304614e+12 -7.84402640e+11  9.00138359e+10\n",
      "  1.14812282e+11]\n",
      "Any non-positive shells? True\n"
     ]
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    },
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 840x384 with 1 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "# Attempt to import geometry helpers; if it fails, define minimal local versions\n",
    "try:\n",
    "    from shot_processing import build_L_onion, ascending_suffix\n",
    "    _GEOM_SOURCE = \"shot_processing\"\n",
    "except Exception as e:\n",
    "    print(\"WARNING: could not import shot_processing geometry helpers; using local minimal versions.\")\n",
    "    print(\"  import error:\", repr(e))\n",
    "    _GEOM_SOURCE = \"local\"\n",
    "\n",
    "    def path_length_annulus(b, r_in, r_out, elec_rad):\n",
    "        b = abs(float(b))\n",
    "        r_in = float(r_in)\n",
    "        r_out = float(r_out)\n",
    "        elec_rad = float(elec_rad)\n",
    "        root_out = np.sqrt(max(r_out * r_out - b * b, 0.0))\n",
    "        if b >= r_in or r_in < elec_rad:\n",
    "            return root_out\n",
    "        root_in = np.sqrt(max(r_in * r_in - b * b, 0.0))\n",
    "        return root_out - root_in\n",
    "\n",
    "    def build_L_onion(chords_abs, edges, elec_rad=0.0):\n",
    "        chords_abs = np.asarray(chords_abs, dtype=float)\n",
    "        edges = np.asarray(edges, dtype=float)\n",
    "        M = len(chords_abs)\n",
    "        N = len(edges) - 1\n",
    "        L = np.zeros((M, N), dtype=float)\n",
    "\n",
    "        for i, b in enumerate(chords_abs):\n",
    "            one_sided = (abs(b) < elec_rad)\n",
    "            for j in range(N):\n",
    "                r_in = edges[j + 1]\n",
    "                r_out = edges[j]\n",
    "                seg = path_length_annulus(b, r_in, r_out, elec_rad)\n",
    "                if one_sided:\n",
    "                    L[i, j] = seg\n",
    "                    if r_in < elec_rad:\n",
    "                        L[i, j] = L[i, j] - np.sqrt(max(elec_rad * elec_rad - b * b, 0.0))\n",
    "                else:\n",
    "                    L[i, j] = 2.0 * seg\n",
    "        return L\n",
    "\n",
    "    def ascending_suffix(b_abs, I_avg, elec_rad, min_len=2, inner_chord_num=0):\n",
    "        b_abs = np.asarray(b_abs, float)\n",
    "        I_avg = np.asarray(I_avg, float)\n",
    "\n",
    "        idx = np.where(b_abs < elec_rad)[0]\n",
    "        if idx.size > 0:\n",
    "            first_inner_idx = int(idx[0])\n",
    "            b_keep = np.array(np.append(b_abs[:first_inner_idx], b_abs[first_inner_idx + inner_chord_num]))\n",
    "            I_keep = np.array(np.append(I_avg[:first_inner_idx], I_avg[first_inner_idx + inner_chord_num]))\n",
    "        else:\n",
    "            b_keep = b_abs\n",
    "            I_keep = I_avg\n",
    "\n",
    "        if len(b_keep) < min_len:\n",
    "            raise ValueError(\n",
    "                f\"After ascending-suffix + electrode crop, only {len(b_keep)} chord(s) remain; need at least {min_len}.\"\n",
    "            )\n",
    "\n",
    "        return b_keep, I_keep\n",
    "\n",
    "print(\"Geometry helper source:\", _GEOM_SOURCE)\n",
    "\n",
    "USE_RIGHT_SIDE_ONLY = True\n",
    "ELEC_RAD_MM = 0.4\n",
    "R_MM = 11.8\n",
    "N_SHELLS = 5\n",
    "\n",
    "# Use B edge-subtracted chord signal at λ0 as input to inversion\n",
    "chord_signal = np.asarray(B_sub, dtype=float)\n",
    "if chord_signal.size != 20:\n",
    "    raise ValueError(\"Expected 20 fibers/chords\")\n",
    "\n",
    "b_raw = np.linspace(R_MM, 0.0, 10)  # mm, outer -> center on ONE side\n",
    "I_left = chord_signal[:10]           # fiber 1..10\n",
    "I_right = np.flip(chord_signal[10:]) # fiber 20..11 (outer->center)\n",
    "I_use = I_right if USE_RIGHT_SIDE_ONLY else I_left\n",
    "\n",
    "# Preprocess (match the idea of keeping a monotone-ish suffix near center)\n",
    "b_keep, I_keep = ascending_suffix(b_raw, I_use, elec_rad=float(ELEC_RAD_MM), inner_chord_num=0)\n",
    "b_keep = np.asarray(b_keep, dtype=float)\n",
    "I_keep = np.asarray(I_keep, dtype=float)\n",
    "print(\"Using chords for inversion:\")\n",
    "print(\"  b_keep(mm) =\", b_keep)\n",
    "print(\"  I_keep     =\", I_keep)\n",
    "\n",
    "# Build onion-peeling geometry matrix (M chords x N shells)\n",
    "edges = np.linspace(R_MM, ELEC_RAD_MM - 0.4, N_SHELLS + 1)\n",
    "L = build_L_onion(b_keep[-N_SHELLS:], edges, elec_rad=float(ELEC_RAD_MM))\n",
    "I_used = I_keep[-N_SHELLS:]\n",
    "print(\"L shape:\", L.shape, \"I_used shape:\", I_used.shape)\n",
    "\n",
    "# Simple least squares (no regularization)\n",
    "eps_ls, *_ = np.linalg.lstsq(L, I_used, rcond=None)\n",
    "eps_ls = np.asarray(eps_ls, dtype=float)\n",
    "\n",
    "# Diagnostics\n",
    "neg = eps_ls <= 0\n",
    "print(\"Shell emissivities (LS):\", eps_ls)\n",
    "print(\"Any non-positive shells?\", bool(np.any(neg)))\n",
    "\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(eps_ls, \"o-\")\n",
    "plt.axhline(0, color=\"k\", lw=1, alpha=0.5)\n",
    "plt.title(\"Method B Step 3: recovered shell emissivities (least squares)\")\n",
    "plt.xlabel(\"Shell index (outer→inner)\")\n",
    "plt.ylabel(\"Emissivity (arb)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "# Check reconstruction quality\n",
    "I_recon = L @ eps_ls\n",
    "plt.figure(figsize=(7, 3.2))\n",
    "plt.plot(I_used, \"o-\", label=\"measured (subset)\")\n",
    "plt.plot(I_recon, \"s--\", label=\"reconstructed\")\n",
    "plt.title(\"Method B Step 3: chord fit check (subset used)\")\n",
    "plt.xlabel(\"Chord index (subset)\")\n",
    "plt.ylabel(\"Chord signal (arb)\")\n",
    "plt.grid(True, alpha=0.25)\n",
    "plt.legend()\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
